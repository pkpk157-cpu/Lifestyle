<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      READ_SMS is the whole point of this build: it is what lets the app scan
      the inbox for bank and UPI alerts without you exporting anything.

      There is deliberately NO INTERNET permission. The web app is served from
      bundled assets, so it needs none, and without it the app is structurally
      incapable of sending your messages anywhere. If you ever want the Google
      Drive sync feature from the PWA build, add:
        <uses-permission android:name="android.permission.INTERNET" />
      and understand that you are giving up that guarantee.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
